{
  "manifest_version": 3,
  "name": "Oopz 按键说话",
  "version": "0.1.6",
  "description": "为 Oopz 网页版加入全局按键说话，需配合本地助手 OopzPtt.exe 使用。",
  "homepage_url": "https://github.com/IOL0ol1/oopz-ptt",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.oopz.cn/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.oopz.cn/*"],
      "js": ["oopz-ptt.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
